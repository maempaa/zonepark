# ─────────────────────────────────────────────────────────────
#  ZonePark — configuración
#  Copia este archivo a .env y ajusta lo que necesites.
# ─────────────────────────────────────────────────────────────

# ── Puertos ──────────────────────────────────────────────────
# API_PORT y WEB_PORT se usan tanto en el host como dentro del
# contenedor, así que cambiar el número aquí basta.
# DB_PORT y REDIS_PORT son SOLO del host: dentro de la red de
# docker, postgres siempre escucha en 5432 y redis en 6379.
# Se eligen fuera de los puertos por defecto a propósito: en una máquina de
# desarrollo suele haber ya un postgres en 5432 y algo escuchando en 8000.
API_PORT=8010
WEB_PORT=4321
DB_PORT=55432
REDIS_PORT=6379
PROXY_PORT=8080

# ── Base de datos ────────────────────────────────────────────
POSTGRES_USER=zonepark
POSTGRES_PASSWORD=zonepark_dev
POSTGRES_DB=zonepark
# Se arma sola a partir de las tres anteriores. Descoméntala solo
# si apuntas a una base externa.
# DATABASE_URL=postgresql+asyncpg://usuario:clave@host:5432/base

# ── Seguridad ────────────────────────────────────────────────
# En producción: openssl rand -hex 32
JWT_SECRET=dev_secret_cambiar_en_produccion
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:4321

# ── Aplicación ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
TENANT_MODE=path
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_CURRENCY=COP
DEFAULT_ROUNDING_STEP=50

# ── URLs de la API ───────────────────────────────────────────
# Por defecto se derivan solas de API_PORT, así que no hace falta
# tocarlas. Descoméntalas solo si el backend vive en otra parte.
#   PUBLIC:   la usa el navegador del operario (pasa por el host).
#   INTERNAL: la usa Astro al renderizar, dentro de la red de docker.
# PUBLIC_API_BASE_URL=http://localhost:8010
# INTERNAL_API_BASE_URL=http://api:8010
