---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { apiGet } from '../lib/api';
import { leerSesion } from '../lib/session';

// Con sesión abierta se va directo al parqueadero.
const sesion = leerSesion(Astro.cookies);
if (sesion) {
  return Astro.redirect(`/t/${sesion.tenant}`);
}

const meta = await apiGet<{ default_currency: string }>('/api/v1/meta');
const enDesarrollo = import.meta.env.DEV;
---
<Base titulo="Entrar">
  <main class="flex flex-1 flex-col justify-center px-6 py-10">
    <header class="mb-8 text-center">
      <Logo alto={52} class="mx-auto" />
      <h1 class="mt-6 text-zp-xl font-extrabold">Administración de parqueaderos</h1>
      <p class="mt-1 text-zp-body text-on-surface-variant">
        Escribe el identificador de tu parqueadero
      </p>
    </header>

    <form method="GET" id="ir" class="space-y-4">
      <input
        type="text"
        name="p"
        required
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        placeholder="por ejemplo: central"
        class="w-full rounded-zp border-2 border-outline bg-surface-container-lowest px-4 py-4
               text-center text-zp-lg font-semibold text-on-surface
               placeholder:text-outline-variant"
      />
      <button
        type="submit"
        class="w-full rounded-zp border-2 border-outline bg-primary px-4 py-4 text-zp-lg
               font-extrabold uppercase tracking-wide text-on-primary
               active:bg-primary-container"
      >
        Continuar
      </button>
    </form>

    {enDesarrollo && (
      <div class="mt-10 space-y-2 text-center">
        <p class="text-zp-caption font-bold uppercase tracking-wide text-on-surface-variant">Parqueaderos de prueba</p>
        <div class="flex justify-center gap-3">
          <a class="text-zp-body font-bold underline underline-offset-4" href="/t/central/login">
            central
          </a>
          <a class="text-zp-body font-bold underline underline-offset-4" href="/t/norte/login">
            norte
          </a>
        </div>
        <p class="pt-4 text-zp-caption text-on-surface-variant">
          <a class="hover:underline" href="/estado">Estado del sistema</a>
          {meta.ok && <span> · moneda {meta.data.default_currency}</span>}
        </p>
      </div>
    )}
  </main>

  <script>
    // Sin JS el formulario haría GET a /?p=…; con JS va a la ruta del tenant.
    document.getElementById('ir')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const campo = (e.target as HTMLFormElement).elements.namedItem('p') as HTMLInputElement;
      const slug = campo.value.trim().toLowerCase();
      if (slug) window.location.href = `/t/${encodeURIComponent(slug)}/login`;
    });
  </script>
</Base>
