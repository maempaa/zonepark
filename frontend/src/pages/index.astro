---
import Base from '../layouts/Base.astro';
import { apiGet } from '../lib/api';
import { leerSesion } from '../lib/session';

// Con sesión abierta se va directo al parqueadero.
const sesion = leerSesion(Astro.cookies);
if (sesion) {
  return Astro.redirect(`/t/${sesion.tenant}`);
}

const meta = await apiGet<{ default_currency: string }>('/api/v1/meta');
const enDesarrollo = import.meta.env.DEV;
---
<Base titulo="Entrar">
  <main class="flex flex-1 flex-col justify-center px-6 py-10">
    <header class="mb-8 text-center">
      <p class="text-sm font-medium uppercase tracking-widest text-brand-600">ZonePark</p>
      <h1 class="mt-2 text-2xl font-bold">Administración de parqueaderos</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
        Escribe el identificador de tu parqueadero
      </p>
    </header>

    <form method="GET" id="ir" class="space-y-4">
      <input
        type="text"
        name="p"
        required
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        placeholder="por ejemplo: central"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-center text-lg
               text-slate-900 outline-none focus:border-brand-500 focus:ring-2
               focus:ring-brand-500/30 dark:border-slate-700 dark:bg-slate-900
               dark:text-slate-100"
      />
      <button
        type="submit"
        class="w-full rounded-xl bg-brand-600 px-4 py-4 text-lg font-semibold text-white
               transition active:bg-brand-700"
      >
        Continuar
      </button>
    </form>

    {enDesarrollo && (
      <div class="mt-10 space-y-2 text-center">
        <p class="text-xs uppercase tracking-wide text-slate-400">Parqueaderos de prueba</p>
        <div class="flex justify-center gap-3">
          <a class="text-sm font-medium text-brand-600 hover:underline" href="/t/central/login">
            central
          </a>
          <a class="text-sm font-medium text-brand-600 hover:underline" href="/t/norte/login">
            norte
          </a>
        </div>
        <p class="pt-4 text-xs text-slate-400">
          <a class="hover:underline" href="/estado">Estado del sistema</a>
          {meta.ok && <span> · moneda {meta.data.default_currency}</span>}
        </p>
      </div>
    )}
  </main>

  <script>
    // Sin JS el formulario haría GET a /?p=…; con JS va a la ruta del tenant.
    document.getElementById('ir')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const campo = (e.target as HTMLFormElement).elements.namedItem('p') as HTMLInputElement;
      const slug = campo.value.trim().toLowerCase();
      if (slug) window.location.href = `/t/${encodeURIComponent(slug)}/login`;
    });
  </script>
</Base>
