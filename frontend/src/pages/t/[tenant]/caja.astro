---
import Base from '../../../layouts/Base.astro';
import Caja from '../../../components/Caja';
import { llamarApi } from '../../../lib/api';

const { tenant } = Astro.params;

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil = await perfilRes.json();

if (!perfil.permisos.includes('cash:operate')) {
  return new Response('Tu rol no maneja caja', { status: 403 });
}

const sedesRes = await llamarApi(Astro.cookies, tenant!, '/sedes');
const sedes = sedesRes?.ok ? await sedesRes.json() : [];
const sedeInicial = sedes[0]?.id ?? '';

// Si ya hay turno abierto se trae desde el servidor, para que la pantalla
// aparezca en su estado real sin un parpadeo.
let inicial = null;
if (sedeInicial) {
  const turnoRes = await llamarApi(
    Astro.cookies,
    tenant!,
    `/caja/mi-turno?parking_lot_id=${sedeInicial}`,
  );
  if (turnoRes?.ok) inicial = await turnoRes.json();
}
---
<Base titulo="Caja">
  <header class="px-5 pt-8 pb-5">
    <a href={`/t/${tenant}`} class="text-sm font-medium text-brand-600 dark:text-brand-500">
      ← Tablero
    </a>
    <h1 class="mt-2 text-xl font-bold">Caja</h1>
  </header>

  <main class="flex-1 px-5 pb-10">
    {sedes.length === 0 ? (
      <p class="rounded-2xl bg-white p-5 text-sm text-slate-500 shadow-sm dark:bg-slate-900">
        No tienes sedes asignadas.
      </p>
    ) : (
      <Caja
        tenant={tenant!}
        sedes={sedes}
        inicial={inicial}
        sedeInicial={sedeInicial}
        client:load
      />
    )}
  </main>
</Base>
