---
import Base from '../../../layouts/Base.astro';
import CerrarSesion from '../../../components/CerrarSesion';
import Logo from '../../../components/Logo.astro';
import Placa from '../../../components/Placa.astro';
import { llamarApi } from '../../../lib/api';

const { tenant } = Astro.params;

interface Perfil {
  nombre: string;
  tenant_nombre: string;
  roles: string[];
  permisos: string[];
  sedes: string[] | null;
}
interface Sede { id: string; codigo: string; nombre: string }
interface Ticket { id: string; codigo: string; placa: string | null; entrada_at: string }

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil: Perfil = await perfilRes.json();

const sedesRes = await llamarApi(Astro.cookies, tenant!, '/sedes');
const sedes: Sede[] = sedesRes?.ok ? await sedesRes.json() : [];

const puedeOperar = perfil.permisos.includes('ticket:read');
const abiertosRes = puedeOperar
  ? await llamarApi(Astro.cookies, tenant!, '/tickets?estado=abierto&limite=200')
  : null;
const abiertos: Ticket[] = abiertosRes?.ok ? await abiertosRes.json() : [];

const puedeIngresar = perfil.permisos.includes('ticket:create');
const puedeVerTarifas = perfil.permisos.includes('rate:read');
const puedeCaja = perfil.permisos.includes('cash:operate');
const puedeReportes = perfil.permisos.includes('report:read');

const atajos = [
  puedeCaja && {
    href: `/t/${tenant}/caja`,
    titulo: 'Caja',
    detalle: 'Turno, movimientos y cierre',
  },
  puedeReportes && {
    href: `/t/${tenant}/reportes`,
    titulo: 'Reportes',
    detalle: 'Ocupación e ingresos',
  },
  puedeVerTarifas && {
    href: `/t/${tenant}/config/tarifas`,
    titulo: 'Tarifas',
    detalle: 'Planes vigentes y simulador',
  },
  perfil.permisos.includes('lot:read') && {
    href: `/t/${tenant}/config/catalogo`,
    titulo: 'Catálogo',
    detalle: 'Tipos de vehículo y artículos',
  },
].filter(Boolean) as Array<{ href: string; titulo: string; detalle: string }>;

const sedeUnica = perfil.sedes !== null && sedes.length === 1 ? sedes[0].nombre : null;
---
<Base titulo={perfil.tenant_nombre}>
  <header class="flex items-center justify-between gap-3 border-b-2 border-outline px-6 py-4">
    <div class="flex min-w-0 items-center gap-3">
      <Logo soloIsotipo alto={32} />
      <div class="min-w-0">
        <p class="truncate text-zp-body font-extrabold leading-tight">
          {perfil.tenant_nombre}
        </p>
        <p class="truncate text-zp-caption text-on-surface-variant">
          {perfil.nombre} · {perfil.roles.join(', ')}
        </p>
      </div>
    </div>
    <CerrarSesion tenant={tenant!} client:load />
  </header>

  <main class="flex-1 space-y-4 px-6 py-6">
    {puedeOperar && (
      <section class="rounded-zp border-2 border-outline bg-surface-container-lowest p-6 text-center">
        <p class="text-zp-4xl font-extrabold leading-none tabular-nums">{abiertos.length}</p>
        <p class="mt-2 text-zp-body text-on-surface-variant">
          {abiertos.length === 1 ? 'vehículo adentro' : 'vehículos adentro'}
          {sedeUnica && ` · ${sedeUnica}`}
        </p>
      </section>
    )}

    <!-- Las dos acciones del turno. El amarillo es la más frecuente; el
         negro la que mueve plata. Colores opuestos para que no se confundan
         de un vistazo. -->
    <div class="grid gap-4 sm:grid-cols-2">
      {puedeIngresar && (
        <a
          href={`/t/${tenant}/ingresar`}
          class="flex flex-col items-center justify-center gap-2 rounded-zp border-2
                 border-outline bg-primary px-4 py-7 text-on-primary transition
                 active:bg-primary-container"
        >
          <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M4 21h16" />
          </svg>
          <span class="text-zp-lg font-extrabold uppercase tracking-wide">Ingreso</span>
        </a>
      )}
      {puedeOperar && (
        <a
          href={`/t/${tenant}/buscar`}
          class="flex flex-col items-center justify-center gap-2 rounded-zp border-2
                 border-outline bg-secondary px-4 py-7 text-on-secondary transition
                 active:bg-secondary-container"
        >
          <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21V9" /><path d="m7 14 5-5 5 5" /><path d="M4 3h16" />
          </svg>
          <span class="text-zp-lg font-extrabold uppercase tracking-wide">Salida</span>
        </a>
      )}
    </div>

    {abiertos.length > 0 && (
      <section class="space-y-3">
        <h2 class="text-zp-caption font-bold uppercase tracking-wide text-on-surface-variant">
          Últimos ingresos
        </h2>
        <ul class="space-y-3">
          {abiertos.slice(0, 5).map((t) => (
            <li>
              <a
                href={`/t/${tenant}/tickets/${t.id}`}
                class="flex items-center justify-between gap-3 rounded-zp border-2 border-outline
                       bg-surface-container-lowest p-4 transition active:bg-surface-container"
              >
                <div class="flex min-w-0 items-center gap-3">
                  <Placa placa={t.placa} codigo={t.codigo} class="text-zp-lg" />
                  {t.placa && (
                    <span class="truncate text-zp-caption text-on-surface-variant">
                      {t.codigo}
                    </span>
                  )}
                </div>
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none"
                     stroke="currentColor" stroke-width="3" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {atajos.length > 0 && (
      <section class="space-y-3 pt-2">
        <h2 class="text-zp-caption font-bold uppercase tracking-wide text-on-surface-variant">
          Administración
        </h2>
        <ul class="space-y-3">
          {atajos.map((a) => (
            <li>
              <a
                href={a.href}
                class="flex items-center justify-between gap-3 rounded-zp border-2 border-outline
                       bg-surface-container-lowest p-4 transition active:bg-surface-container"
              >
                <div class="min-w-0">
                  <p class="text-zp-body font-bold">{a.titulo}</p>
                  <p class="truncate text-zp-caption text-on-surface-variant">{a.detalle}</p>
                </div>
                <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none"
                     stroke="currentColor" stroke-width="3" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>
