---
import Base from '../../../layouts/Base.astro';
import CerrarSesion from '../../../components/CerrarSesion';
import { llamarApi } from '../../../lib/api';

const { tenant } = Astro.params;

interface Perfil {
  nombre: string;
  tenant_nombre: string;
  roles: string[];
  permisos: string[];
  sedes: string[] | null;
}
interface Sede { id: string; codigo: string; nombre: string }
interface Ticket { id: string; codigo: string; placa: string | null; entrada_at: string }

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil: Perfil = await perfilRes.json();

const sedesRes = await llamarApi(Astro.cookies, tenant!, '/sedes');
const sedes: Sede[] = sedesRes?.ok ? await sedesRes.json() : [];

const puedeOperar = perfil.permisos.includes('ticket:read');
const abiertosRes = puedeOperar
  ? await llamarApi(Astro.cookies, tenant!, '/tickets?estado=abierto&limite=200')
  : null;
const abiertos: Ticket[] = abiertosRes?.ok ? await abiertosRes.json() : [];

const puedeIngresar = perfil.permisos.includes('ticket:create');
const puedeVerTarifas = perfil.permisos.includes('rate:read');
---
<Base titulo={perfil.tenant_nombre}>
  <header class="flex items-start justify-between gap-3 px-5 pt-8 pb-6">
    <div class="min-w-0">
      <h1 class="truncate text-xl font-bold">{perfil.tenant_nombre}</h1>
      <p class="mt-0.5 truncate text-sm text-slate-500 dark:text-slate-400">
        {perfil.nombre} · {perfil.roles.join(', ')}
      </p>
    </div>
    <CerrarSesion tenant={tenant!} client:load />
  </header>

  <main class="flex-1 space-y-5 px-5 pb-10">
    {puedeOperar && (
      <section class="rounded-2xl bg-white p-5 text-center shadow-sm dark:bg-slate-900">
        <p class="text-5xl font-bold tabular-nums">{abiertos.length}</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          {abiertos.length === 1 ? 'vehículo adentro' : 'vehículos adentro'}
          {perfil.sedes !== null && sedes.length === 1 && ` · ${sedes[0].nombre}`}
        </p>
      </section>
    )}

    <div class="grid gap-3 sm:grid-cols-2">
      {puedeIngresar && (
        <a
          href={`/t/${tenant}/ingresar`}
          class="flex flex-col items-center justify-center gap-1 rounded-2xl bg-brand-600 px-4
                 py-8 text-white shadow-md active:bg-brand-700"
        >
          <span class="text-3xl leading-none">🅿️</span>
          <span class="text-lg font-semibold">Ingreso</span>
        </a>
      )}
      {puedeOperar && (
        <a
          href={`/t/${tenant}/buscar`}
          class="flex flex-col items-center justify-center gap-1 rounded-2xl bg-emerald-600 px-4
                 py-8 text-white shadow-md active:bg-emerald-700"
        >
          <span class="text-3xl leading-none">💵</span>
          <span class="text-lg font-semibold">Salida</span>
        </a>
      )}
    </div>

    {abiertos.length > 0 && (
      <section class="space-y-2">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
          Últimos ingresos
        </h2>
        <ul class="space-y-2">
          {abiertos.slice(0, 5).map((t) => (
            <li>
              <a
                href={`/t/${tenant}/tickets/${t.id}`}
                class="flex items-center justify-between gap-3 rounded-2xl bg-white p-4 shadow-sm
                       active:bg-slate-50 dark:bg-slate-900 dark:active:bg-slate-800"
              >
                <div class="min-w-0">
                  <p class="truncate text-lg font-bold tracking-wide">
                    {t.placa ?? 'Sin placa'}
                  </p>
                  <p class="text-sm text-slate-500 dark:text-slate-400">{t.codigo}</p>
                </div>
                <span class="shrink-0 text-slate-400">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {puedeVerTarifas && (
      <a
        href={`/t/${tenant}/config/tarifas`}
        class="flex items-center justify-between gap-3 rounded-2xl bg-white p-4 shadow-sm
               active:bg-slate-50 dark:bg-slate-900 dark:active:bg-slate-800"
      >
        <div>
          <p class="font-semibold">Tarifas</p>
          <p class="text-sm text-slate-500 dark:text-slate-400">Planes vigentes y simulador</p>
        </div>
        <span class="text-slate-400">→</span>
      </a>
    )}
  </main>
</Base>
