---
import Base from '../../../../layouts/Base.astro';
import CobrarTicket from '../../../../components/CobrarTicket';
import Placa from '../../../../components/Placa.astro';
import { llamarApi } from '../../../../lib/api';

const { tenant, id } = Astro.params;

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil = await perfilRes.json();

const ticketRes = await llamarApi(Astro.cookies, tenant!, `/tickets/${id}`);
if (!ticketRes || ticketRes.status === 404) {
  return new Response('No existe ese ticket', { status: 404 });
}
if (!ticketRes.ok) {
  return new Response('No puedes ver este ticket', { status: ticketRes.status });
}
const ticket = await ticketRes.json();

const articulosRes = await llamarApi(Astro.cookies, tenant!, '/articulos');
const articulos = articulosRes?.ok ? await articulosRes.json() : [];

const puedeCobrar = perfil.permisos.includes('ticket:checkout');
---
<Base titulo={ticket.placa ?? ticket.codigo}>
  <header class="flex items-center gap-3 border-b-2 border-outline px-6 py-4">
    <a
      href={`/t/${tenant}/buscar`}
      aria-label="Volver a la búsqueda"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-zp border-2
             border-outline bg-surface-container-lowest active:bg-surface-container"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor"
           stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </a>
    <h1 class="text-zp-lg font-extrabold">{ticket.codigo}</h1>
  </header>

  <main class="flex-1 px-6 py-6">
    {ticket.estado === 'anulado' ? (
      <div class="space-y-4 rounded-zp border-2 border-error bg-surface-container-lowest p-6
                  text-center">
        <p class="text-zp-lg font-extrabold text-error">Ticket anulado</p>
        <Placa placa={ticket.placa} codigo={ticket.codigo} class="text-zp-lg" />
        <p class="text-zp-body text-on-surface-variant">{ticket.anulacion_motivo}</p>
      </div>
    ) : ticket.estado === 'cerrado' ? (
      <div class="space-y-4 rounded-zp border-2 border-outline bg-surface-container-lowest p-6
                  text-center">
        <Placa placa={ticket.placa} codigo={ticket.codigo} class="text-zp-2xl" />
        <p class="text-zp-body text-on-surface-variant">Ya fue cobrado y cerrado.</p>
        <a
          href={`/t/${tenant}/buscar`}
          class="block w-full rounded-zp border-2 border-outline bg-primary px-4 py-4
                 text-zp-body font-extrabold uppercase tracking-wide text-on-primary
                 active:bg-primary-container"
        >
          Siguiente vehículo
        </a>
      </div>
    ) : puedeCobrar ? (
      <CobrarTicket tenant={tenant!} ticket={ticket} articulos={articulos} client:load />
    ) : (
      <div class="space-y-4 rounded-zp border-2 border-outline bg-surface-container-lowest p-6
                  text-center">
        <Placa placa={ticket.placa} codigo={ticket.codigo} class="text-zp-2xl" />
        <p class="text-zp-body text-on-surface-variant">Tu rol no cobra tickets.</p>
      </div>
    )}
  </main>
</Base>
