---
import Base from '../../../layouts/Base.astro';
import RegistrarIngreso from '../../../components/RegistrarIngreso';
import { llamarApi } from '../../../lib/api';

const { tenant } = Astro.params;

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil = await perfilRes.json();

if (!perfil.permisos.includes('ticket:create')) {
  return new Response('No tienes permiso para registrar ingresos', { status: 403 });
}

const sedesRes = await llamarApi(Astro.cookies, tenant!, '/sedes');
const sedes = sedesRes?.ok ? await sedesRes.json() : [];

const tiposRes = await llamarApi(Astro.cookies, tenant!, '/tipos-vehiculo');
const tipos = tiposRes?.ok ? await tiposRes.json() : [];
---
<Base titulo="Ingreso">
  <header class="px-5 pt-8 pb-5">
    <a href={`/t/${tenant}`} class="text-sm font-medium text-brand-600 dark:text-brand-500">
      ← Tablero
    </a>
    <h1 class="mt-2 text-xl font-bold">Registrar ingreso</h1>
  </header>

  <main class="flex-1 px-5 pb-10">
    {sedes.length === 0 || tipos.length === 0 ? (
      <p class="rounded-2xl bg-white p-5 text-sm text-slate-500 shadow-sm dark:bg-slate-900">
        No hay sedes o tipos de vehículo configurados.
      </p>
    ) : (
      <RegistrarIngreso tenant={tenant!} sedes={sedes} tipos={tipos} client:load />
    )}
  </main>
</Base>
