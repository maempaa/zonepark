---
import Base from '../../../../layouts/Base.astro';
import EditorTarifas from '../../../../components/EditorTarifas';
import { llamarApi } from '../../../../lib/api';

const { tenant } = Astro.params;

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil = await perfilRes.json();

if (!perfil.permisos.includes('rate:read')) {
  return new Response('No tienes permiso para ver las tarifas', { status: 403 });
}
const puedeEditar = perfil.permisos.includes('rate:manage');

const [planesRes, tiposRes] = await Promise.all([
  llamarApi(Astro.cookies, tenant!, '/planes'),
  llamarApi(Astro.cookies, tenant!, '/tipos-vehiculo'),
]);
const planes = planesRes?.ok ? await planesRes.json() : [];
const tipos = tiposRes?.ok ? await tiposRes.json() : [];
---
<Base titulo="Tarifas" ancho>
  <header class="flex items-center gap-3 border-b-2 border-outline px-6 py-4">
    <a
      href={`/t/${tenant}`}
      aria-label="Volver al tablero"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-zp border-2
             border-outline bg-surface-container-lowest active:bg-surface-container"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor"
           stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </a>
    <h1 class="text-zp-lg font-extrabold">Tarifas</h1>
  </header>

  <main class="flex-1 px-6 py-6">
    {planes.length === 0 || tipos.length === 0 ? (
      <p class="rounded-zp border-2 border-outline bg-surface-container-lowest p-5
                text-zp-body text-on-surface-variant">
        Todavía no hay planes tarifarios ni tipos de vehículo. Corre
        <code class="mx-1 rounded border-2 border-outline-variant px-1.5 py-0.5 text-zp-caption">
          make seed
        </code>
        para cargar los de ejemplo.
      </p>
    ) : puedeEditar ? (
      <EditorTarifas tenant={tenant!} planes={planes} tipos={tipos} client:load />
    ) : (
      <div class="space-y-3">
        <p class="rounded-zp border-2 border-outline-variant p-4 text-zp-body
                  text-on-surface-variant">
          Tu rol puede consultar las tarifas, pero no cambiarlas.
        </p>
        <ul class="overflow-hidden rounded-zp border-2 border-outline
                   bg-surface-container-lowest">
          {planes.map((p: any) => (
            <li class="flex items-center justify-between gap-3 border-b border-outline-variant
                       px-4 py-3 last:border-0">
              <span class="text-zp-body"><strong>{p.nombre}</strong> v{p.version}</span>
              <span class="shrink-0 rounded-zp border-2 border-outline px-2.5 py-0.5
                           text-zp-caption font-bold uppercase">{p.estado}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </main>
</Base>
