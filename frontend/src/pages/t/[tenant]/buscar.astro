---
import Base from '../../../layouts/Base.astro';
import BuscarTicket from '../../../components/BuscarTicket';
import CabeceraPantalla from '../../../components/CabeceraPantalla.astro';
import { llamarApi } from '../../../lib/api';

const { tenant } = Astro.params;

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil = await perfilRes.json();

if (!perfil.permisos.includes('ticket:read')) {
  return new Response('No tienes permiso para consultar tickets', { status: 403 });
}

// Se renderiza en el servidor para que la lista aparezca ya poblada.
const abiertosRes = await llamarApi(Astro.cookies, tenant!, '/tickets?estado=abierto');
const abiertos = abiertosRes?.ok ? await abiertosRes.json() : [];
---
<Base titulo="Salida">
  <CabeceraPantalla titulo="Salida" volverA={`/t/${tenant}`} etiquetaVolver="Volver al tablero" />

  <main class="flex-1 px-6 py-6">
    <BuscarTicket tenant={tenant!} iniciales={abiertos} client:load />
  </main>
</Base>
