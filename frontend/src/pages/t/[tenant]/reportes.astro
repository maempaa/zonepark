---
import Base from '../../../layouts/Base.astro';
import CabeceraPantalla from '../../../components/CabeceraPantalla.astro';
import TablaConceptos from '../../../components/TablaConceptos.astro';
import { llamarApi } from '../../../lib/api';

const { tenant } = Astro.params;

const perfilRes = await llamarApi(Astro.cookies, tenant!, '/auth/me');
if (!perfilRes || !perfilRes.ok) return Astro.redirect(`/t/${tenant}/login`);
const perfil = await perfilRes.json();

if (!perfil.permisos.includes('report:read')) {
  return new Response('Tu rol no ve reportes', { status: 403 });
}

const url = new URL(Astro.request.url);
const desde = url.searchParams.get('desde') ?? '';
const hasta = url.searchParams.get('hasta') ?? '';
const consulta = new URLSearchParams();
if (desde) consulta.set('desde', desde);
if (hasta) consulta.set('hasta', hasta);
const sufijo = consulta.toString() ? `?${consulta}` : '';

const [ocupacionRes, ingresosRes] = await Promise.all([
  llamarApi(Astro.cookies, tenant!, '/reportes/ocupacion'),
  llamarApi(Astro.cookies, tenant!, `/reportes/ingresos${sufijo}`),
]);

const ocupacion = ocupacionRes?.ok ? await ocupacionRes.json() : { total: 0, filas: [] };
const ingresos = ingresosRes?.ok ? await ingresosRes.json() : null;
const errorRango = ingresosRes && !ingresosRes.ok ? (await ingresosRes.json()).detail : null;

const puedeVerCaja = perfil.permisos.includes('cash:read');
const descuadresRes = puedeVerCaja
  ? await llamarApi(Astro.cookies, tenant!, '/caja/descuadres?limite=5')
  : null;
const descuadres = descuadresRes?.ok ? await descuadresRes.json() : [];

const money = (v: string | number) =>
  new Intl.NumberFormat('es-CO', {
    style: 'currency', currency: 'COP', maximumFractionDigits: 0,
  }).format(Number(v));

// La barra más alta marca la escala del resto.
const maximo = ingresos?.por_dia?.length
  ? Math.max(...ingresos.por_dia.map((f: any) => Number(f.total)))
  : 0;

const CAMPO_FECHA =
  'mt-1 block rounded-zp border-2 border-outline bg-surface-container-lowest px-3 py-2 ' +
  'text-zp-body font-semibold';
---
<Base titulo="Reportes" anchura="tablet">
  <CabeceraPantalla titulo="Reportes" volverA={`/t/${tenant}`} etiquetaVolver="Volver al tablero" />

  <main class="flex-1 space-y-8 px-6 py-6">
    <section class="rounded-zp border-2 border-outline bg-surface-container-lowest p-6
                    text-center">
      <p class="text-zp-4xl font-extrabold leading-none tabular-nums">{ocupacion.total}</p>
      <p class="mt-2 text-zp-body text-on-surface-variant">
        {ocupacion.total === 1 ? 'vehículo adentro ahora' : 'vehículos adentro ahora'}
      </p>
      {ocupacion.filas.length > 0 && (
        <ul class="mt-4 flex flex-wrap justify-center gap-2">
          {ocupacion.filas.map((f: any) => (
            <li class="rounded-zp border-2 border-outline px-3 py-1.5 text-zp-caption font-bold">
              {f.tipo}: <span class="tabular-nums">{f.adentro}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="space-y-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-zp-lg font-extrabold">Ingresos</h2>
        <form method="GET" class="flex flex-wrap items-end gap-3">
          <label class="text-zp-caption font-bold uppercase tracking-wide text-on-surface-variant">
            Desde
            <input type="date" name="desde" value={desde} class={CAMPO_FECHA} />
          </label>
          <label class="text-zp-caption font-bold uppercase tracking-wide text-on-surface-variant">
            Hasta
            <input type="date" name="hasta" value={hasta} class={CAMPO_FECHA} />
          </label>
          <button
            type="submit"
            class="rounded-zp border-2 border-outline bg-primary px-5 py-2.5 text-zp-body
                   font-extrabold uppercase tracking-wide text-on-primary
                   active:bg-primary-container"
          >
            Ver
          </button>
        </form>
      </div>

      {errorRango && (
        <p class="flex items-start gap-3 rounded-zp border-2 border-error
                  bg-surface-container-lowest px-4 py-3 text-zp-body font-semibold text-error">
          <svg viewBox="0 0 24 24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v6" /><path d="M12 16.5v.01" />
          </svg>
          <span>{errorRango}</span>
        </p>
      )}

      {ingresos && (
        <>
          <div class="flex flex-wrap items-baseline justify-between gap-4 rounded-zp border-2
                      border-outline bg-surface-container-lowest p-6">
            <div>
              <p class="text-zp-3xl font-extrabold leading-none tabular-nums">
                {money(ingresos.total)}
              </p>
              <p class="mt-2 text-zp-body text-on-surface-variant">
                {ingresos.tickets} tickets · {ingresos.desde} a {ingresos.hasta}
              </p>
            </div>
            <a
              href={`/api/v1/t/${tenant}/reportes/ingresos.csv${sufijo}`}
              class="rounded-zp border-2 border-outline px-4 py-3 text-zp-body font-bold
                     active:bg-surface-container"
            >
              Descargar CSV
            </a>
          </div>

          {ingresos.por_dia.length > 0 && (
            <div class="overflow-x-auto rounded-zp border-2 border-outline
                        bg-surface-container-lowest p-5">
              <ul class="flex min-w-max items-end gap-2" style="height: 150px">
                {ingresos.por_dia.map((f: any) => (
                  <li class="flex w-12 flex-col items-center justify-end gap-1.5">
                    <span class="text-zp-caption font-bold tabular-nums">
                      {Math.round(Number(f.total) / 1000)}k
                    </span>
                    <div
                      class="w-full rounded-t border-2 border-outline bg-primary"
                      style={`height: ${maximo ? Math.max(6, (Number(f.total) / maximo) * 100) : 6}px`}
                      title={`${f.dia}: ${money(f.total)}`}
                    />
                    <span class="text-zp-caption text-on-surface-variant">{f.dia.slice(8)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="grid gap-4 sm:grid-cols-2">
            <TablaConceptos titulo="Por forma de pago" filas={ingresos.por_metodo} />
            <TablaConceptos titulo="Por tipo de vehículo" filas={ingresos.por_tipo} />
          </div>
        </>
      )}
    </section>

    {puedeVerCaja && descuadres.length > 0 && (
      <section class="space-y-3">
        <h2 class="text-zp-lg font-extrabold">Turnos que no cuadraron</h2>
        <ul class="overflow-hidden rounded-zp border-2 border-outline
                   bg-surface-container-lowest">
          {descuadres.map((t: any) => (
            <li class="flex items-baseline justify-between gap-3 border-b border-outline-variant
                       px-4 py-3 last:border-0">
              <div class="min-w-0">
                <p class="text-zp-body">{new Date(t.abierto_at).toLocaleDateString('es-CO')}</p>
                <p class="truncate text-zp-caption text-on-surface-variant">
                  esperado {money(t.esperado)} · contado {money(t.contado)}
                </p>
              </div>
              <p class:list={[
                'shrink-0 text-zp-lg font-extrabold tabular-nums',
                Number(t.diferencia) < 0 ? 'text-error' : 'text-success',
              ]}>
                {money(t.diferencia)}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Base>
