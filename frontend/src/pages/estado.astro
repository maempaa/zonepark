---
import Base from '../layouts/Base.astro';
import PruebaConexion from '../components/PruebaConexion';
import { apiGet } from '../lib/api';

// Render en el servidor: Astro habla con FastAPI por la red interna.
const salud = await apiGet<{ status: string; env: string; database: string }>('/health');
const meta = await apiGet<{ app: string; version: string }>('/api/v1/meta');

const filas = [
  { nombre: 'Astro (SSR)', ok: true, detalle: 'renderizando esta página' },
  {
    nombre: 'FastAPI',
    ok: salud.ok,
    detalle: salud.ok ? `entorno ${salud.data.env}` : salud.error,
  },
  {
    nombre: 'PostgreSQL',
    ok: salud.ok && salud.data.database === 'ok',
    detalle: salud.ok ? salud.data.database : 'sin verificar',
  },
];
---
<Base titulo="Estado">
  <header class="px-6 pt-8 pb-6">
    <h1 class="text-zp-xl font-extrabold">Estado del sistema</h1>
    <p class="mt-1 text-zp-body text-on-surface-variant">
      {meta.ok ? `ZonePark v${meta.data.version}` : 'Sin respuesta de la API'}
    </p>
  </header>

  <main class="flex-1 space-y-6 px-6 pb-10">
    <ul class="overflow-hidden rounded-zp border-2 border-outline bg-surface-container-lowest">
      {filas.map((f) => (
        <li class="flex items-center justify-between gap-3 border-b border-outline-variant
                   px-4 py-4 last:border-0">
          <div class="min-w-0">
            <p class="text-zp-body font-bold">{f.nombre}</p>
            <p class="truncate text-zp-caption text-on-surface-variant">{f.detalle}</p>
          </div>
          <span
            class:list={[
              'flex shrink-0 items-center gap-1.5 rounded-zp border-2 px-3 py-1',
              'text-zp-caption font-bold uppercase tracking-wide',
              f.ok ? 'border-success text-success' : 'border-error text-error',
            ]}
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor"
                 stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={f.ok ? 'm4 12 6 6L20 6' : 'M6 6l12 12M18 6L6 18'} />
            </svg>
            {f.ok ? 'OK' : 'Falla'}
          </span>
        </li>
      ))}
    </ul>

    <section class="space-y-3">
      <h2 class="text-zp-caption font-bold uppercase tracking-wide text-on-surface-variant">
        Desde el navegador
      </h2>
      <PruebaConexion client:load />
      <p class="text-zp-caption text-on-surface-variant">
        Este botón sale del navegador, pasa por el proxy de Astro y llega a FastAPI.
        Comprueba la cadena que usará el operario.
      </p>
    </section>
  </main>
</Base>
