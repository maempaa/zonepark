---
/**
 * Logotipo de ZonePark.
 *
 * Por defecto va el logotipo completo —isotipo y palabra— desde el PNG de
 * marca, recortado a su caja, con el blanco convertido en transparencia y
 * a unas tres veces el tamaño al que se muestra, para que se vea nítido en
 * pantallas de alta densidad sin cargar el original de 1024 px.
 *
 * `soloIsotipo` usa el SVG del pin: pesa 543 bytes y escala sin límite.
 * Es el que conviene en barras y espacios estrechos, y el que hace de
 * favicon.
 */
interface Props {
  /** Altura en píxeles. El ancho sale de la proporción. */
  alto?: number;
  /** Solo el pin, sin la palabra. Para espacios estrechos. */
  soloIsotipo?: boolean;
  class?: string;
}
const { alto = 48, soloIsotipo = false, class: clase } = Astro.props;

// Proporciones reales de cada archivo, para reservar el espacio exacto y
// que la página no salte cuando la imagen termina de cargar.
const proporcion = soloIsotipo ? 96 / 128 : 480 / 157;
const ancho = Math.round(alto * proporcion);
---
<img
  src={soloIsotipo ? '/isotipo.svg' : '/logo.png'}
  alt="ZonePark"
  width={ancho}
  height={alto}
  class:list={['block h-auto', clase]}
  style={`width:${ancho}px`}
  decoding="async"
/>
