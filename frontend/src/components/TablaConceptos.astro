---
interface Props {
  titulo: string;
  filas: Array<{ concepto: string; tickets: number; total: string }>;
}
const { titulo, filas } = Astro.props;
const money = (v: string | number) =>
  new Intl.NumberFormat('es-CO', {
    style: 'currency', currency: 'COP', maximumFractionDigits: 0,
  }).format(Number(v));
---
<div class="overflow-hidden rounded-zp border-2 border-outline bg-surface-container-lowest">
  <p class="border-b-2 border-outline px-4 py-3 text-zp-caption font-bold uppercase
            tracking-wide text-on-surface-variant">
    {titulo}
  </p>
  {filas.length === 0 ? (
    <p class="px-4 py-5 text-zp-body text-on-surface-variant">Sin datos en el rango</p>
  ) : (
    <ul>
      {filas.map((f) => (
        <li class="flex items-baseline justify-between gap-3 border-b border-outline-variant
                   px-4 py-3 last:border-0">
          <span class="truncate text-zp-body capitalize">{f.concepto}</span>
          <span class="shrink-0 text-zp-body font-semibold tabular-nums">
            {money(f.total)}
            <span class="ml-2 text-zp-caption font-normal text-on-surface-variant">
              ({f.tickets})
            </span>
          </span>
        </li>
      ))}
    </ul>
  )}
</div>
