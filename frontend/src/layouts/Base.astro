---
import '../styles/global.css';

interface Props {
  titulo: string;
  /** Las pantallas de configuración y reportes se usan en tablet o escritorio. */
  ancho?: boolean;
}
const { titulo, ancho = false } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: respeta el notch; sin maximum-scale para no romper el zoom accesible -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffd700" />
    <link rel="icon" href="/isotipo.svg" type="image/svg+xml" />
    <title>{titulo} · ZonePark</title>

    {/* Inter con `swap`: si la fuente tarda o no llega, el texto se pinta
        igual con la pila del sistema en vez de quedarse invisible. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body class="min-h-dvh bg-surface font-sans text-on-surface antialiased">
    <div class:list={["mx-auto flex min-h-dvh w-full flex-col", ancho ? "max-w-3xl" : "max-w-md"]}>
      <slot />
    </div>
  </body>
</html>
